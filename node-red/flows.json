        "order": 1,
        "width": "0",
        "height": "0",
        "format": "<style>\n    .terminal-container {\n        background-color: #000;\n        color: #00ff00;\n        padding: 10px;\n        font-family: 'Courier New', monospace;\n        border: 2px solid #444;\n        border-radius: 5px;\n        height: 250px;\n        overflow-y: auto;\n        overflow-x: hidden;\n        box-shadow: inset 0 0 10px #000;\n    }\n\n    .log-line {\n        border-bottom: 1px solid #222;\n        padding: 4px 0;\n        font-size: 13px;\n        /* MODIFICA QUI: Permette al testo di andare a capo */\n        white-space: pre-wrap;\n        /* Mantiene gli spazi e va a capo */\n        word-wrap: break-word;\n        /* Spezza le parole se troppo lunghe */\n        display: flex;\n        /* Allinea bene il prompt '>' con il testo */\n    }\n\n    .prompt {\n        color: #008800;\n        font-weight: bold;\n        margin-right: 8px;\n        flex-shrink: 0;\n        /* Impedisce al '>' di rimpicciolirsi */\n    }\n\n    .log-content {\n        flex-grow: 1;\n    }\n</style>\n\n<div class=\"terminal-container\">\n    <div ng-repeat=\"linea in msg.payload track by $index\" class=\"log-line\">\n        <span class=\"prompt\">></span>\n        <span class=\"log-content\">{{linea}}</span>\n    </div>\n</div>",
