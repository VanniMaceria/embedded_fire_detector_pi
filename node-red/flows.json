    {
        "id": "13aaf2cec3603a39",
        "type": "function",
        "z": "236df39e11bb332e",
        "name": "function decrypt",
        "func": "// La chiave dal tuo file key.py\nconst password = \"aB1cDe2fGh3iJk4lMn5oPq6rSt7uVw8x\";\nconst encryptedPayload = msg.payload;\n\ntry {\n    // 1. Preparazione della chiave come WordArray (formato richiesto da CryptoJS)\n    const key = CryptoJS.enc.Utf8.parse(password);\n\n    // 2. Decrittazione AES-256 ECB\n    const decrypted = CryptoJS.AES.decrypt(encryptedPayload, key, {\n        mode: CryptoJS.mode.ECB,\n        padding: CryptoJS.pad.Pkcs7\n    });\n\n    // 3. Conversione in stringa UTF-8\n    const decryptedText = decrypted.toString(CryptoJS.enc.Utf8);\n\n    if (!decryptedText) {\n        throw new Error(\"Chiave errata o dati corrotti\");\n    }\n\n    // 4. Trasformazione della stringa in oggetto JSON\n    msg.payload = JSON.parse(decryptedText);\n\n    return msg;\n\n} catch (e) {\n    node.error(\"Errore Decrittazione: \" + e.message);\n    return null; // Blocca il flusso se il dato è illeggibile\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
