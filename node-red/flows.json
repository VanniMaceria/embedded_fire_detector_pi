    {
        "id": "138a31cbe2734667",
        "type": "function",
        "z": "236df39e11bb332e",
        "name": "function return keys",
        "func": "// 1. Recuperiamo lo storico (o creiamo un array vuoto se è la prima volta)\nvar storico = flow.get('storico_incendi') || [];\n\n// 2. Prendiamo i dati in arrivo dal nodo JSON\nvar dati = msg.payload;\nvar prob = Math.floor(dati.probability * 100);\n\n// 3. Creiamo la riga per il log\nvar nuovaRiga = \"[\" + dati.timestamp + \"] STATO: \" + dati.status + \" - PROB: \" + prob + \"%\";\n\n// 4. Aggiorniamo lo storico (aggiungi in cima, tieni ultimi 10)\nstorico.unshift(nuovaRiga);\nif (storico.length > 10) { storico.pop(); }\nflow.set('storico_incendi', storico);\n\n// 5. PREPARIAMO I DUE MESSAGGI (QUESTO È IL PUNTO CRITICO)\n// Ogni uscita deve essere un OGGETTO con dentro la proprietà 'payload'\n\nvar msg_per_gauge = { payload: prob };      // Inviato all'uscita 1\nvar msg_per_logger = { payload: storico };  // Inviato all'uscita 2\n\n// 6. Restituiamo l'array dei messaggi\nreturn [msg_per_gauge, msg_per_logger];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
